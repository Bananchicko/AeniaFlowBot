# Шаблон для отдельного бота. Свою настроенную .env не заменяйте этим файлом.
BOT_TOKEN=
# Числовые ID обоих администраторов через запятую
# Пример заполнения: ADMIN_IDS=111111111,222222222
# Каждый указанный администратор получает Plus автоматически и без срока.
ADMIN_IDS=
# Поддержка проекта из исходного архива. Username без @.
SUPPORT_USERNAME=alcLua
# Только Telegram Stars. Цена в целых Stars; 1 Star = 1 XTR.
STARS_DAY=5
STARS_THREE_DAYS=10
STARS_WEEK=20
STARS_FORTNIGHT=30
STARS_MONTH=50
STARS_QUARTER=100
STARS_HALFYEAR=200
STARS_YEAR=400
# Обязательный канал для бесплатного доступа. Plus и администраторы освобождены.
# Пусто означает @AeniaFlow. Менять удобнее через .AdminMenu.
NEWS_CHANNEL=@AeniaFlow
NEWS_CHANNEL_URL=https://t.me/AeniaFlow
# Необязательно. Ключ нужен для ИИ и распознавания речи.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_DAILY_LIMIT=40
DATABASE_PATH=./data/aeniaflow.sqlite3
MAX_DOWNLOAD_MB=20
COMMAND_COOLDOWN=0
LOG_LEVEL=INFO
# Необязательно: путь к готовому FFmpeg; пусто — bin/ffmpeg, затем системный PATH.
FFMPEG_PATH=
